# Base configuration — committed defaults, no secrets
APP_NAME=peek-demo
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=3000

# Database (overridden per environment)
DATABASE_URL="postgres://peek:peek@localhost:5432/peek_dev"
DATABASE_POOL_SIZE=5

# Feature flags
FEATURE_SIGNUP=on
FEATURE_BETA_UI=off

# Quoting conventions
GREETING="hello world"
PATH_PREFIX='/usr/local/bin'
EMPTY=
