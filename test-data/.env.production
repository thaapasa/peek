# Production configuration — placeholder values, NOT real secrets
APP_ENV=production
DEBUG=false
LOG_LEVEL=warn

# Server
HOST=0.0.0.0
PORT=8080
WORKERS=8

# Managed services (substituted by the deploy platform at release time)
DATABASE_URL="postgres://peek:CHANGEME@db.internal:5432/peek_prod?sslmode=require"
DATABASE_POOL_SIZE=20
REDIS_URL=rediss://cache.internal:6380/0

# Secrets injected from the vault — placeholders only
API_KEY=__INJECTED_AT_DEPLOY__
JWT_SECRET=__INJECTED_AT_DEPLOY__
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Feature flags
FEATURE_SIGNUP=on
FEATURE_BETA_UI=off
