<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>GitHub Light</string>
  <key>settings</key>
  <array>
    <!-- Global settings (GitHub Primer light) -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>    <string>#FFFFFF</string>
        <key>foreground</key>    <string>#1F2328</string>
        <key>caret</key>         <string>#1F2328</string>
        <key>selection</key>     <string>#B6E3FF</string>
        <key>lineHighlight</key> <string>#F6F8FA</string>
        <key>gutterForeground</key> <string>#8C959F</string>
        <key>findHighlight</key> <string>#FFF8C5</string>
        <key>accent</key>        <string>#0969DA</string>
      </dict>
    </dict>

    <!-- Comments -->
    <dict>
      <key>name</key>  <string>Comment</string>
      <key>scope</key> <string>comment, comment.line, comment.block</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#6E7781</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Doc Comment</string>
      <key>scope</key> <string>comment.block.documentation, comment.line.documentation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#6E7781</string>
        <key>fontStyle</key>  <string>italic</string>
      </dict>
    </dict>

    <!-- Keywords (red) -->
    <dict>
      <key>name</key>  <string>Keyword</string>
      <key>scope</key> <string>keyword, keyword.control, storage, storage.type, storage.modifier</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#CF222E</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Operator</string>
      <key>scope</key> <string>keyword.operator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>

    <!-- Strings (navy) -->
    <dict>
      <key>name</key>  <string>String</string>
      <key>scope</key> <string>string, string.quoted</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0A3069</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>String Escape</string>
      <key>scope</key> <string>constant.character.escape</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>

    <!-- Constants (blue) -->
    <dict>
      <key>name</key>  <string>Number</string>
      <key>scope</key> <string>constant.numeric</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Language Constant</string>
      <key>scope</key> <string>constant.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Other Constant</string>
      <key>scope</key> <string>constant.other, support.constant</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>

    <!-- Functions (purple) -->
    <dict>
      <key>name</key>  <string>Function</string>
      <key>scope</key> <string>entity.name.function, support.function, meta.function-call</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#8250DF</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Macro</string>
      <key>scope</key> <string>entity.name.function.macro, support.function.macro, meta.macro</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#8250DF</string>
      </dict>
    </dict>

    <!-- Types / Classes / Structs (orange) -->
    <dict>
      <key>name</key>  <string>Type</string>
      <key>scope</key> <string>entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.union, entity.name.trait, support.type, support.class, storage.type.numeric, storage.type.boolean, storage.type.string, storage.type.char, storage.type.primitive</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#953800</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Enum Variant</string>
      <key>scope</key> <string>constant.other.enum, entity.name.enum-variant, variable.other.enummember</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Type Parameter</string>
      <key>scope</key> <string>variable.parameter.type, entity.name.type.parameter, storage.type.generic</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#953800</string>
      </dict>
    </dict>

    <!-- Entity names (tags, sections) -->
    <dict>
      <key>name</key>  <string>Tag</string>
      <key>scope</key> <string>entity.name.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#116329</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Attribute</string>
      <key>scope</key> <string>entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Section</string>
      <key>scope</key> <string>entity.name.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0969DA</string>
        <key>fontStyle</key>  <string>bold</string>
      </dict>
    </dict>

    <!-- Variables (orange) -->
    <dict>
      <key>name</key>  <string>Variable</string>
      <key>scope</key> <string>variable, variable.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#953800</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Member / Field</string>
      <key>scope</key> <string>variable.other.member, variable.other.property, meta.field</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#1F2328</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Self / Language Variable</string>
      <key>scope</key> <string>variable.language, variable.language.self</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#CF222E</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Parameter</string>
      <key>scope</key> <string>variable.parameter</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#1F2328</string>
      </dict>
    </dict>

    <!-- Annotations / Decorators -->
    <dict>
      <key>name</key>  <string>Annotation</string>
      <key>scope</key> <string>storage.type.annotation, meta.annotation, meta.attribute, punctuation.definition.annotation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0550AE</string>
      </dict>
    </dict>

    <!-- Markup -->
    <dict>
      <key>name</key>  <string>Markup Heading</string>
      <key>scope</key> <string>markup.heading</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0969DA</string>
        <key>fontStyle</key>  <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Markup Bold</string>
      <key>scope</key> <string>markup.bold</string>
      <key>settings</key>
      <dict>
        <key>fontStyle</key> <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Markup Italic</string>
      <key>scope</key> <string>markup.italic</string>
      <key>settings</key>
      <dict>
        <key>fontStyle</key> <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Markup Link</string>
      <key>scope</key> <string>markup.underline.link, string.other.link</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#0969DA</string>
      </dict>
    </dict>

    <!-- Invalid -->
    <dict>
      <key>name</key>  <string>Invalid</string>
      <key>scope</key> <string>invalid, invalid.illegal</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#82071E</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>  <string>Deprecated</string>
      <key>scope</key> <string>invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#953800</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
