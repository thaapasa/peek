Cargo.toml text eol=lf

# Documentation
*.txt text
*.log text
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.readme text
*.README text
*.tex text diff=tex

# Windows project files
*.csproj text
*.props text
*.targets text

# Fonts (binary)
*.ttf -text
*.otf -text
*.woff -text
*.woff2 -text
*.eot -text

# Certificates & keys (binary / don't normalize)
*.pem -text
*.key -text
*.pfx -text
*.p12 -text
*.cer -text

# Databases / blobs
*.sqlite -text
*.db -text

# Unix scripts - keep LF only (no CRLF conversion)
*.sh text eol=lf diff=bash
*.bash text eol=lf diff=bash
*.zsh text eol=lf
*.fish text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
.env* text eol=lf

# Windows scripts - keep CRLF only (no LF conversion)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Patches and diffs - keep LF only
*.patch text eol=lf
*.diff text eol=lf

# npm/yarn/bun config - keep LF for consistency with npm standards
package.json text eol=lf

# Lockfiles - collapsed in GitHub diffs, excluded from language stats
package-lock.json text eol=lf linguist-generated=true
yarn.lock text eol=lf linguist-generated=true
pnpm-lock.yaml text eol=lf linguist-generated=true
bun.lock text eol=lf linguist-generated=true
bun.lockb binary linguist-generated=true
Cargo.lock text eol=lf linguist-generated=true

